{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lokerdollar-voice-agent",
	"main": "worker/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	// Supertonic-3 speech. Reuses LokerDollar's social-video image (Node 24 +
	// onnxruntime-node + Supertonic engine), pinned by its unique build tag;
	// worker/tts.ts overrides the entrypoint with a small TTS server.
	"containers": [
		{
			"class_name": "SupertonicTTS",
			"image": "registry.cloudflare.com/6d25a5b669eded616b24f930983daca8/lokerdollar-social-video-remotioncontainer:08208504176",
			"max_instances": 2,
			"instance_type": "standard-3"
		}
	],
	"durable_objects": {
		"bindings": [{ "name": "TTS", "class_name": "SupertonicTTS" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["SupertonicTTS"] }],
	"vars": {
		// Anonymous, read-only LokerDollar MCP server (no key needed).
		"LOKERDOLLAR_MCP_URL": "https://lokerdollar-mcp.kelvin-6d2.workers.dev/mcp",
		// Any Nemotron id from GET https://api.tokenfactory.nebius.com/v1/models
		"NEMOTRON_MODEL": "nvidia/Nemotron-3_5-Lightning"
	}
	// Secrets (never in this file): NEBIUS_API_KEY, and ASSEMBLYAI_API_KEY for ?engine=assemblyai.
	// `wrangler secret put NEBIUS_API_KEY`
}

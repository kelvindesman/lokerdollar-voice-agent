{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "lokerdollar-voice-agent",
	"main": "worker/index.ts",
	"compatibility_date": "2026-03-01",
	"compatibility_flags": ["global_fetch_strictly_public"],
	"workers_dev": true,
	"preview_urls": false,
	"assets": {
		"directory": "./dist",
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": ["/api/*"]
	},
	"vars": {
		// Anonymous, read-only LokerDollar MCP server (no key needed).
		"LOKERDOLLAR_MCP_URL": "https://lokerdollar-mcp.kelvin-6d2.workers.dev/mcp"
	}
	// Secret (never in this file): ASSEMBLYAI_API_KEY — `wrangler secret put ASSEMBLYAI_API_KEY`
}
